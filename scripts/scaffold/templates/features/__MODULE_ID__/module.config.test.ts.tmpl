/**
 * The module contract, the nav metadata and the route layout describe one
 * module. Pinned so the three cannot drift: the same id, the same
 * permission string on the sidebar entry and the metadata gate, and a
 * `ModuleGuard` on the route segment.
 */
import { describe, expect, test } from 'bun:test';
import { readFileSync } from 'node:fs';
import { getPermissionsForRole } from '@/nav/access/roles';
import { __MODULE_CAMEL__Metadata } from '@/nav/metadata/__MODULE_ID__.meta';
import { __MODULE_CAMEL__Module } from './module.config';

const layout = readFileSync(
  new URL('../../app/users/dashboard/__MODULE_ID__/layout.tsx', import.meta.url),
  'utf8'
);

describe('__MODULE_NAME__ module wiring', () => {
  test('the entitlement key follows the module id', () => {
    expect(__MODULE_CAMEL__Module.id).toBe('__MODULE_ID__');
    expect(__MODULE_CAMEL__Module.entitlementFeatureKey).toBe('__FEATURE_KEY__');
  });

  test('the nav entry and the metadata gate on the same permission', () => {
    const entry = __MODULE_CAMEL__Metadata['__MODULE_ID__'];
    expect(entry.moduleId).toBe(__MODULE_CAMEL__Module.id);
    expect(entry.access?.permissions).toEqual(
      __MODULE_CAMEL__Module.nav[0].requiredPermissions
    );
    expect(__MODULE_CAMEL__Module.nav[0].path).toBe('/users/dashboard/__MODULE_ID__');
  });

  test('every role holds the read permission; the module gate is the entitlement', () => {
    for (const role of ['admin', 'manager', 'employee'] as const) {
      expect(getPermissionsForRole(role), role).toContain('__MODULE_ID__:read');
    }
  });

  test('the route segment is guarded by the module id', () => {
    expect(layout).toInclude('<ModuleGuard moduleId="__MODULE_ID__">');
  });
});
