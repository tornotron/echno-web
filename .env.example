# Local development only. Copy to .env and fill in; the file is gitignored and vaulted with envault.
# Deployed environments get these from echno-deployment (Ansible frontend.env.j2, Helm chart).

# Backend REST API, server side only (the BFF proxy forwards /api/v1/* here). Must include /api/v1.
BACKEND_API_URL=http://localhost:8080/api/v1
# Same prefix the browser calls on this app; the BFF proxy sits behind it.
NEXT_PUBLIC_API_URL=/api/v1

# Keycloak OpenID Connect (public client with PKCE, no client secret).
KEYCLOAK_ID=echno-web-client
KEYCLOAK_ISSUER=https://auth.example.test/realms/echno-realm

# Auth.js
NEXTAUTH_URL=http://localhost:3000
# openssl rand -base64 32
NEXTAUTH_SECRET=change-me
AUTH_TRUST_HOST=true

# Public origins
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Object store host the browser reaches for presigned URLs (MinIO or Spaces). Empty for none.
NEXT_PUBLIC_STORAGE_ORIGIN=

# Optional
# REDIS_URL=redis://localhost:6379      # session revocation sync across replicas
# ENABLE_DEBUG_LOGS=true
# TZ=Asia/Kolkata
