{
  "name": "echno-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:next": "next dev",
    "dev": "concurrently --kill-others --names routes,next --prefix-colors cyan,green \"bun routes:watch\" \"bun dev:next\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "bun test",
    "preinstall": "npx only-allow bun",
    "prepare": "husky",
    "routes:generate": "node --experimental-strip-types scripts/generate-routes.ts",
    "routes:watch": "node --experimental-strip-types scripts/watch-routes.ts"
  },
  "dependencies": {
